# ---------------------------------------------------------------------------
# LEAF configuration
# Copy this file to `.env` and edit the values you need.
# Every value has a safe default; AI, email delivery and HTTPS are opt-in.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port for the Express API. Vite runs on 5173 and proxies /api to this port.
PORT=4001

# Where the browser app is hosted. Used for CORS-free same-origin links only in
# development; in production set PUBLIC_APP_URL and APP_URL to the same origin.
APP_URL=http://localhost:5173

# Canonical public origin used in share links and transactional emails.
# Example production value: https://leaf.example.com
PUBLIC_APP_URL=http://localhost:5173

# SQLite database file. The directory is created automatically.
LEAF_DB_PATH=server/data/leaf.db

# Uploaded profile photos. Must be writable by the API process and persisted
# across deploys. Served at /uploads in development and production.
LEAF_UPLOADS_DIR=server/uploads

# Session cookie name and lifetime (days). Use `__Host-leaf_session` on HTTPS
# if you terminate TLS at the application rather than a proxy.
SESSION_COOKIE=leaf_session
SESSION_DAYS=7

# Number of reverse-proxy hops to trust for client IPs and secure cookies.
# Keep 0 when connecting directly. Set 1 behind a single trusted proxy.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# AI (optional)
# LEAF talks to any OpenAI-compatible /chat/completions endpoint.
# Leave AI_API_KEY empty to run without AI. Manual editing, local reviews,
# sharing and PDF export all continue to work.
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Per-user AI actions per UTC day (rewrite, skills, review, draft).
AI_DAILY_LIMIT=20

# Provider request timeout in milliseconds.
AI_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Email (optional)
# Without a Resend key, verification and reset links are logged to the API
# console and returned in development API responses. No mail is delivered.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=LEAF <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# PDF rendering
# LEAF uses a locally installed Chromium browser via playwright-core.
# Leave empty to auto-detect Chrome/Edge. Set an explicit executable if needed.
# ---------------------------------------------------------------------------
CHROME_PATH=

# Maximum profile-photo upload size in bytes (default 3 MB).
UPLOAD_MAX_BYTES=3145728

# Send HSTS headers. Defaults to true when NODE_ENV=production. Only enable on
# an HTTPS origin you control.
ENABLE_HSTS=true

# ---------------------------------------------------------------------------
# Frontend build (Vite, optional)
# Leave empty when the Vite dev server and API share an origin through the
# proxy, or when Express serves dist/ in production. Set only when the API is
# hosted on a different origin.
# ---------------------------------------------------------------------------
# VITE_API_URL=https://api.example.com

# ---------------------------------------------------------------------------
# Demo seed (optional; consumed by `npm run seed`)
# ---------------------------------------------------------------------------
SEED_EMAIL=demo@leaf.app
SEED_PASSWORD=LeafDemo123
